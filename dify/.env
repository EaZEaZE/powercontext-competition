# deploy.sh 使用的源码实例路径（本次验证实例）
DIFY_SRC=/root/dify-src
DIFY_SANDBOX_DIR=/root/dify-sandbox
SEEKDB_DIR=/root/seekdb-data

# Dify 源码服务监听地址
DIFY_API_HOST=0.0.0.0
DIFY_API_PORT=5001
DIFY_WEB_PORT=3000
UV_BIN=/root/uvenv/bin/uv
PNPM_BIN=/opt/node22/bin/pnpm

# 嵌入式 seekdb 与桥接
SEEKDB_DATABASE=test
SEEKDB_BRIDGE_PORT=18080
SEEKDB_BRIDGE_URL=http://127.0.0.1:18080

# 本次实际验证的 Dify 内部存储配置（用于核对 $DIFY_SRC/api/.env）
# seekdb 由 Workflow 桥接使用，不替代以下 Dify 元数据库/内部 VectorStore。
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dify
VECTOR_STORE=pgvector
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Web 的 $DIFY_SRC/web/.env.local 应指向：
# NEXT_PUBLIC_API_PREFIX=http://127.0.0.1:5001/console/api
# NEXT_PUBLIC_PUBLIC_API_PREFIX=http://127.0.0.1:5001/api
